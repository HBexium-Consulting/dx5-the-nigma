{
  "name": "dx5-site",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Site officiel DX-5 The Nigma — service TypeScript (Fastify + SQLite), piloté par le Dashboard HBEXIUM.",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "node --watch src/server.ts",
    "start": "node src/server.ts",
    "seed": "node src/seed.ts",
    "reconcile": "node src/hbx/reconcile.ts --run",
    "outbox:flush": "node src/hbx/outbox.ts --flush",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@fastify/static": "^8.0.0",
    "fastify": "^5.2.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "typescript": "^5.7.0",
    "vitest": "^3.0.0"
  }
}